{
  "name": "cabinet-stoica",
  "productName": "Cabinet Stoica",
  "version": "1.2.0",
  "description": "Gestiunea activității cabinetului de avocat Stoica Ioana",
  "author": "Cabinet de avocat Stoica Ioana",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "build": {
    "appId": "ro.cabinetstoica.app",
    "productName": "Cabinet Stoica",
    "copyright": "Cabinet de avocat Stoica Ioana",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "build/icon.png",
      "electron/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Cabinet Stoica",
      "artifactName": "Cabinet-Stoica-Instalare-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Cabinet-Stoica-Portabil-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "dmg": {
      "artifactName": "Cabinet-Stoica-${version}.${ext}"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    },
    "afterPack": "build/afterPack.js"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pe-library": "^2.0.1",
    "resedit": "^3.1.0"
  }
}
